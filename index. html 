
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VIP Smart Calculator</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #080808, #172b35);
    font-family: Arial, sans-serif;
}

.calculator {
    width: 340px;
    padding: 22px;
    background: #17212b;
    border-radius: 22px;
    box-shadow: 0 10px 35px #0009;
}

h2 {
    color: #00e5a0;
    text-align: center;
    margin-top: 0;
}

#display {
    width: 100%;
    height: 75px;
    margin-bottom: 18px;
    background: #071019;
    color: white;
    border: 2px solid #00c98b;
    border-radius: 12px;
    text-align: right;
    padding: 12px;
    font-size: 30px;
}

.buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

button {
    height: 60px;
    border: none;
    border-radius: 12px;
    font-size: 22px;
    font-weight: bold;
    background: #304252;
    color: white;
}

button:active {
    transform: scale(0.94);
}

.operator {
    background: #007f65;
}

.clear {
    background: #d33b48;
}

.equal {
    background: #00a878;
    grid-column: span 2;
}

footer {
    color: #aebfc9;
    text-align: center;
    margin-top: 20px;
    font-size: 12px;
}
</style>
</head>

<body>
<div class="calculator">

<h2>VIP SMART</h2>

<input id="display" value="0" readonly>

<div class="buttons">
<button class="clear" onclick="clearDisplay()">AC</button>
<button onclick="deleteLast()">DEL</button>
<button class="operator" onclick="add('/')">÷</button>
<button class="operator" onclick="add('*')">×</button>

<button onclick="add('7')">7</button>
<button onclick="add('8')">8</button>
<button onclick="add('9')">9</button>
<button class="operator" onclick="add('-')">−</button>

<button onclick="add('4')">4</button>
<button onclick="add('5')">5</button>
<button onclick="add('6')">6</button>
<button class="operator" onclick="add('+')">+</button>

<button onclick="add('1')">1</button>
<button onclick="add('2')">2</button>
<button onclick="add('3')">3</button>
<button onclick="add('.')">.</button>

<button onclick="add('0')">0</button>
<button class="equal" onclick="calculate()">=</button>
</div>

<footer>VIP ABSUM © 2026</footer>
</div>

<script>
const display = document.getElementById("display");

function add(value) {
    if (display.value === "Error") display.value = "";
    if (display.value === "0") display.value = "";
    display.value += value;
}

function clearDisplay() {
    display.value = "0";
}

function deleteLast() {
    display.value = display.value.slice(0, -1) || "0";
}

function calculate() {
    try {
        const expression = display.value;

        if (!/^[0-9+\-*/.() ]+$/.test(expression)) {
            throw new Error("Invalid");
        }

        const result = Function(
            '"use strict"; return (' + expression + ')'
        )();

        if (!Number.isFinite(result)) {
            throw new Error("Invalid");
        }

        display.value = Number(result.toPrecision(12)).toString();
    } catch {
        display.value = "Error";
    }
}
</script>

</body>
</html>
